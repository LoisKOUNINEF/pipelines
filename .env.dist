SSH_PORT=
SSH_HOST=
SSH_USER=
SSH_PASS=

SSH_PRIVATE_KEY=

# Get SSH_FINGERPRINT:
# ssh-keyscan -t ed25519 -p <port> <host> | ssh-keygen -lf -
SSH_FINGERPRINT=

# Create PAT:
# GitHub → Settings → Developer settings → Tokens (classic) → new token with read:packages scope.
PAT=
# Generate DOCKER_AUTH:
# printf '%s' 'username:PAT' | base64 | tr -d '\n'
DOCKER_AUTH=

# Apps with a database: encrypts the backups, changing it makes older backups unreadable.
ENCRYPTION_PASSWORD=

# Chrome Web Store ('store' environment):
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
CWS_PUBLISHER_ID=
CWS_EXTENSION_ID=

# Firefox Add-ons ('store' environment):
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
